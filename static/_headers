# Cloudflare Workers static assets: 静态图片与构建资产长缓存
# 注意：/images 下的文件名一旦发布就不要原地替换内容——改图请换新文件名（如 -v2），
# 否则回访用户会在缓存期内继续看到旧图。

/journeys/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
