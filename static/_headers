# Cloudflare Workers static assets：HTML 短缓存 + 静态资源长缓存
# 顺序有意义：后面的规则覆盖前面的同名头。
# HTML（含手写页）：5 分钟内复用，过期后后台重验，避免每次打开都回源。
/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# 注意：/images 下的文件名一旦发布就不要原地替换内容——改图请换新文件名（如 -v2），
# 否则回访用户会在缓存期内继续看到旧图。

/journeys/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
